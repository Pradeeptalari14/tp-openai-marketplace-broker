# OpenAI Marketplace Broker Configuration
# Port and Server Binding
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# OpenAI API Authentication
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
OPENAI_ORG_ID=org-placeholder-here

# Quota & Token Management Thresholds
MAX_TOKENS_PER_MINUTE=200000
MAX_REQUESTS_PER_MINUTE=5000
FALLBACK_MODEL=gpt-4o-mini
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/placeholder
